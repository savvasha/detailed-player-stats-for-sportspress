<?xml version="1.0"?>
<ruleset name="Detailed Player Stats for SportsPress">
	<description>WordPress Coding Standards for Detailed Player Stats for SportsPress (PHP).</description>

	<!-- Scan the current directory. -->
	<file>.</file>

	<!-- Only scan PHP files; JS/CSS are linted with ESLint/Stylelint. -->
	<arg name="extensions" value="php"/>

	<!-- Exclude third-party code and build artifacts. -->
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Show sniff codes and progress. -->
	<arg value="ps"/>

	<!-- Minimum supported WordPress version. -->
	<config name="minimum_wp_version" value="5.9"/>

	<!-- The WordPress Coding Standards ruleset. -->
	<rule ref="WordPress"/>

	<!-- Check PHP cross-version compatibility (minimum supported PHP). -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- The main plugin file must keep its plugin-slug name, so the
	     class-file-naming convention does not apply to it. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/detailed-player-stats-for-sportspress.php</exclude-pattern>
	</rule>

	<!-- Verify text domain and global prefixes. As a SportsPress add-on this
	     plugin intentionally reuses the 'sportspress' text domain for shared UI
	     strings so they inherit SportsPress's own translations. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="detailed-player-stats-for-sportspress"/>
				<element value="sportspress"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dpsfs"/>
				<element value="DPSFS"/>
				<element value="Detailed_Player_Stats_For_SportsPress"/>
			</property>
		</properties>
	</rule>
</ruleset>
